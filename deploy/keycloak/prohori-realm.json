{
  "realm": "prohori",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "clients": [
    {
      "clientId": "prohori-dashboard",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [],
      "optionalClientScopes": [
        "user/*.write",
        "patient/*.rs",
        "launch",
        "launch/patient",
        "fhirUser"
      ],
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "prohori-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "patient",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "patient",
            "claim.value": "prohori-smart-demo",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        },
        {
          "name": "fhirUser",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "fhirUser",
            "claim.value": "http://localhost:5279/fhir/Patient/prohori-smart-demo",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "prohori-api",
      "bearerOnly": true
    }
  ],
  "clientScopes": [
    {
      "name": "user/*.write",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      },
      "protocolMappers": []
    },
    {
      "name": "patient/*.rs",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      },
      "protocolMappers": []
    },
    {
      "name": "launch",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      },
      "protocolMappers": []
    },
    {
      "name": "launch/patient",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      },
      "protocolMappers": []
    },
    {
      "name": "fhirUser",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      },
      "protocolMappers": []
    }
  ],
  "users": [
    {
      "username": "demo",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "synthetic-demo-only",
          "temporary": false
        }
      ],
      "firstName": "Synthetic",
      "lastName": "Demo",
      "email": "demo@example.invalid",
      "emailVerified": true
    }
  ]
}
