  Accept: application/fhir+json
}

docs {
  # Composite param — two components on the SAME element occurrence

  `code-value-concept = <code>$<value>` binds the LOINC code and the SNOMED
  result value together, so a negative NS1 + a positive malaria RDT on the same
  patient does NOT match. Expect 3 (Rahman, Jamal, Nasima).
}
