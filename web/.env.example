# FHIR R4 server the dashboard reads from.
# Phase A–D: the public HAPI sandbox. Phase E: your local Docker HAPI. Phase F/G: the BD-Core sandbox.
VITE_FHIR_BASE=https://hapi.fhir.org/baseR4

# Prohori.Api (Phase C) — used by the "New case" link only.
VITE_API_BASE=http://localhost:5279

# Prohori.Subscriber (Phase O) — SSE stream for live dashboard updates. Local-only.
VITE_SUBSCRIBER_BASE=http://localhost:5300

# SMART launch registration (optional; query-string iss takes precedence)
VITE_SMART_CLIENT_ID=prohori-dashboard
# VITE_SMART_ISS=http://localhost:5279/fhir
