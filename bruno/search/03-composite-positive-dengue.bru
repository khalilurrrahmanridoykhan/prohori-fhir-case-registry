  name: 03 Composite — positive dengue NS1
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/Observation?code-value-concept=http://loinc.org|42239-4$http://snomed.info/sct|10828004&_tag=urn:prohori|demo-cohort
  body: none
