# Used by `vite build` for the live Vercel deploy.
# The dashboard reads directly from Bangladesh's national FHIR sandbox.
VITE_FHIR_BASE=https://sandbox.fhir.dghs.gov.bd/fhir
VITE_API_BASE=https://prohori-api.onrender.com
# No VITE_SUBSCRIBER_BASE here, deliberately: Prohori.Subscriber (Phase O) isn't deployed
# anywhere public (it needs to stay running to hold open SSE connections and its own
# Subscription registration — a different shape of "always-on" than the stateless API, not
# worth standing up for a demo). useLiveUpdates degrades to "unavailable" without it, same
# as every other local-only feature since Phase C.
